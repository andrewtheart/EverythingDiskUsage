<Window x:Class="EverythingDiskUsage.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:EverythingDiskUsage.Models"
        mc:Ignorable="d"
        Icon="pack://siteoforigin:,,,/Assets/AppIcon.ico"
        Title="Everything Disk Usage"
        Height="760"
        Width="1180"
        MinHeight="620"
        MinWidth="920"
        Loaded="Window_Loaded"
        Background="{DynamicResource WindowBackground}">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#F4F6F9" />
        <SolidColorBrush x:Key="PanelBackground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SurfaceAltBackground" Color="#EEF2F6" />
        <SolidColorBrush x:Key="GroupRowBackground" Color="#E9EFF5" />
        <SolidColorBrush x:Key="ControlBackground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BorderColor" Color="#D8DEE8" />
        <SolidColorBrush x:Key="MutedText" Color="#5F6B7A" />
        <SolidColorBrush x:Key="PrimaryText" Color="#18212F" />
        <SolidColorBrush x:Key="AccentBrush" Color="#157A8C" />

        <Style x:Key="ToolbarButton" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="78" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.68" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="IconButton" TargetType="{x:Type Button}" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Width" Value="34" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryText}" />
        </Style>

        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <Grid>
                                                <ContentPresenter Margin="10,0,30,0"
                                                                  HorizontalAlignment="Left"
                                                                  VerticalAlignment="Center"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                                                  ContentTemplateSelector="{Binding ItemTemplateSelector, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                                                  ContentStringFormat="{Binding SelectionBoxItemStringFormat, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}" />
                                                <Path HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,11,0"
                                                      Fill="{DynamicResource PrimaryText}"
                                                      Data="M 0 0 L 8 0 L 4 4 Z" />
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, ElementName=DropDownToggle}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{DynamicResource ControlBackground}"
                                        BorderBrush="{DynamicResource BorderColor}"
                                        BorderThickness="1">
                                    <ScrollViewer CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="DropDownToggle" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SurfaceAltBackground}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type TabControl}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
        </Style>

        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabBorder"
                                Margin="0,0,4,0"
                                Padding="10,5"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SurfaceAltBackground}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource PanelBackground}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ProgressBar}">
            <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
        </Style>

        <Style TargetType="{x:Type TreeViewItem}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
        </Style>

        <Style TargetType="{x:Type ListBoxItem}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
        </Style>

        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="RowBackground" Value="{DynamicResource PanelBackground}" />
        </Style>

        <Style TargetType="{x:Type DataGridRow}">
            <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
        </Style>

        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
        </Style>

        <HierarchicalDataTemplate DataType="{x:Type models:DirectoryUsageNode}" ItemsSource="{Binding Children}">
            <Grid MinWidth="620" Margin="0,2,8,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="105" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="85" />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource PrimaryText}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding SizeText}" HorizontalAlignment="Right" Foreground="{DynamicResource PrimaryText}" />
                <TextBlock Grid.Column="2" Text="{Binding PercentText}" HorizontalAlignment="Right" Foreground="{DynamicResource MutedText}" />
                <TextBlock Grid.Column="3" Text="{Binding FileCountText}" HorizontalAlignment="Right" Foreground="{DynamicResource MutedText}" />
                <TextBlock Grid.Column="4" Text="{Binding FolderCountText}" HorizontalAlignment="Right" Foreground="{DynamicResource MutedText}" />
            </Grid>
        </HierarchicalDataTemplate>

        <DataTemplate x:Key="LegendSliceTemplate" DataType="{x:Type models:PieSlice}">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="12" Height="12" Background="{Binding Fill}" CornerRadius="2" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="8,0,12,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource PrimaryText}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="{Binding SizeText}" Foreground="{DynamicResource PrimaryText}" MinWidth="70" TextAlignment="Right" />
                    <TextBlock Text="{Binding PercentText}" Foreground="{DynamicResource MutedText}" MinWidth="58" TextAlignment="Right" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="16,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Everything Disk Usage" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" />
                        <TextBlock Text="Everything SDK" Foreground="{DynamicResource MutedText}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button x:Name="ThemeButton"
                            DockPanel.Dock="Right"
                            Style="{StaticResource IconButton}"
                            Click="ThemeButton_Click"
                            AutomationProperties.Name="Change color theme">
                        <TextBlock x:Name="ThemeGlyphTextBlock" Text="◐" FontSize="18" VerticalAlignment="Center" />
                    </Button>
                    <TextBlock x:Name="SdkStatusTextBlock" DockPanel.Dock="Right" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center" />
                </DockPanel>

                <Grid Grid.Row="1" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="DriveComboBox" SelectionChanged="DriveComboBox_SelectionChanged" />
                    <TextBox x:Name="RootPathTextBox" Grid.Column="1" Margin="8,0,0,0" KeyDown="RootPathTextBox_KeyDown" />
                    <Button x:Name="BrowseButton" Grid.Column="2" Style="{StaticResource ToolbarButton}" Content="Browse" Click="BrowseButton_Click" />
                    <Button x:Name="ScanButton" Grid.Column="3" Style="{StaticResource PrimaryButton}" Content="Scan" Click="ScanButton_Click" />
                    <Button x:Name="CancelButton" Grid.Column="4" Style="{StaticResource ToolbarButton}" Content="Cancel" Click="CancelButton_Click" IsEnabled="False" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource SurfaceAltBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusTextBlock" Foreground="{DynamicResource PrimaryText}" Text="Ready" />
                <TextBlock x:Name="SummaryTextBlock" Grid.Column="1" Foreground="{DynamicResource MutedText}" />
                <ProgressBar x:Name="ScanProgressBar" Grid.Row="1" Grid.ColumnSpan="2" Height="6" Margin="0,8,0,0" Minimum="0" Maximum="100" Value="0" />
            </Grid>
        </Border>

        <TabControl Grid.Row="2" Margin="16,14,16,12" Background="Transparent" BorderThickness="0">
            <TabItem Header="Chart">
        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="520" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="2*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="22,0,20,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="85" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Name" FontWeight="SemiBold" Foreground="{DynamicResource MutedText}" />
                        <TextBlock Grid.Column="1" Text="Size" FontWeight="SemiBold" Foreground="{DynamicResource MutedText}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="2" Text="%" FontWeight="SemiBold" Foreground="{DynamicResource MutedText}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="Files" FontWeight="SemiBold" Foreground="{DynamicResource MutedText}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="Folders" FontWeight="SemiBold" Foreground="{DynamicResource MutedText}" HorizontalAlignment="Right" />
                    </Grid>
                    <TreeView x:Name="UsageTree"
                              Grid.Row="1"
                              BorderThickness="0"
                              Background="Transparent"
                              PreviewMouseRightButtonDown="UsageTree_PreviewMouseRightButtonDown"
                              SelectedItemChanged="UsageTree_SelectedItemChanged"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling" />
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

            <Border Grid.Column="2" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PieBackButton"
                                    Width="30"
                                    Height="28"
                                    Margin="0,0,8,0"
                                    Padding="0"
                                    Content="←"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Visibility="Collapsed"
                                    ToolTip="Show parent folder"
                                    Click="PieBackButton_Click" />
                            <TextBlock x:Name="SelectedNameTextBlock" Grid.Column="1" Text="No scan loaded" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock x:Name="SelectedPathTextBlock" Foreground="{DynamicResource MutedText}" TextTrimming="CharacterEllipsis" Margin="0,3,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Size" Foreground="{DynamicResource MutedText}" />
                                <TextBlock x:Name="SelectedSizeTextBlock" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="Files" Foreground="{DynamicResource MutedText}" />
                                <TextBlock x:Name="SelectedFilesTextBlock" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="12,0,0,0">
                                <TextBlock Text="Folders" Foreground="{DynamicResource MutedText}" />
                                <TextBlock x:Name="SelectedFoldersTextBlock" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <Grid Grid.Row="1" MinHeight="340" Margin="0,14,0,10">
                        <Canvas x:Name="PieCanvas" SizeChanged="PieCanvas_SizeChanged" />
                        <TextBlock x:Name="EmptyPieTextBlock" Text="No size data" Foreground="{DynamicResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>

                    <ListBox x:Name="LegendItems"
                             Grid.Row="2"
                             ItemTemplate="{StaticResource LegendSliceTemplate}"
                             BorderThickness="0"
                             Background="Transparent"
                             MaxHeight="220"
                             SelectionChanged="LegendItems_SelectionChanged" />
                </Grid>
            </Border>
        </Grid>
            </TabItem>

            <TabItem Header="Details">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" MinWidth="460" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="4*" MinWidth="520" />
                    </Grid.ColumnDefinitions>

                    <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="2,0,2,8">
                                <TextBlock Text="Folders" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" />
                                <TextBlock x:Name="FolderDetailsSummaryTextBlock" DockPanel.Dock="Right" Foreground="{DynamicResource MutedText}" />
                            </DockPanel>
                            <DataGrid x:Name="DirectoryDetailsGrid"
                                      Grid.Row="1"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      EnableRowVirtualization="True"
                                      EnableColumnVirtualization="True"
                                      PreviewMouseRightButtonDown="DirectoryDetailsGrid_PreviewMouseRightButtonDown"
                                      SelectedItem="{Binding ElementName=UsageTree, Path=SelectedItem, Mode=OneWay}"
                                      SelectionChanged="DirectoryDetailsGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="2*" />
                                    <DataGridTextColumn Header="Path" Binding="{Binding FullPath}" Width="3*" />
                                    <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="95" />
                                    <DataGridTextColumn Header="Allocated" Binding="{Binding AllocatedText}" Width="95" />
                                    <DataGridTextColumn Header="Files" Binding="{Binding FileCountText}" Width="80" />
                                    <DataGridTextColumn Header="Folders" Binding="{Binding FolderCountText}" Width="80" />
                                    <DataGridTextColumn Header="% of Parent" Binding="{Binding PercentText}" Width="90" />
                                    <DataGridTextColumn Header="Last Modified" Binding="{Binding LastModifiedText}" Width="130" />
                                    <DataGridTextColumn Header="Last Accessed" Binding="{Binding LastAccessedText}" Width="130" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

                    <Border Grid.Column="2" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="2,0,2,8">
                                <TextBlock Text="Files" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" />
                                <TextBlock x:Name="FileDetailsSummaryTextBlock" DockPanel.Dock="Right" Foreground="{DynamicResource MutedText}" />
                            </DockPanel>
                            <DataGrid x:Name="FileDetailsGrid"
                                      Grid.Row="1"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      SelectionMode="Extended"
                                      SelectionUnit="FullRow"
                                      EnableRowVirtualization="True"
                                      EnableColumnVirtualization="True"
                                      PreviewMouseRightButtonDown="FileDetailsGrid_PreviewMouseRightButtonDown">
                                <DataGrid.RowStyle>
                                    <Style TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Setter Property="Background" Value="{DynamicResource GroupRowBackground}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="2*" />
                                    <DataGridTextColumn Header="Path" Binding="{Binding PathText}" Width="3*" />
                                    <DataGridTextColumn Header="Files" Binding="{Binding FileCountText}" Width="70" />
                                    <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="100" />
                                    <DataGridTextColumn Header="Last Modified" Binding="{Binding LastModifiedText}" Width="130" />
                                    <DataGridTextColumn Header="Last Accessed" Binding="{Binding LastAccessedText}" Width="130" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Duplicates">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*" MinWidth="500" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="3*" MinWidth="320" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="2,0,2,4">
                                <TextBlock Text="Duplicate Files" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" />
                                <TextBlock x:Name="DuplicatesSummaryTextBlock" DockPanel.Dock="Right" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center" />
                            </DockPanel>
                            <DockPanel Grid.Row="1" Margin="2,0,2,8">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <TextBlock Text="Group by" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox x:Name="DuplicateGroupingComboBox"
                                              Width="150"
                                              DisplayMemberPath="DisplayName"
                                              SelectionChanged="DuplicateGroupingComboBox_SelectionChanged" />
                                </StackPanel>
                                <TextBlock Foreground="{DynamicResource MutedText}" FontSize="12" VerticalAlignment="Center"
                                           Text="Matched by identical file name and size  ·  Right-click a file to open its shell menu" />
                            </DockPanel>
                            <DataGrid x:Name="DuplicatesGrid"
                                      Grid.Row="2"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      EnableRowVirtualization="True"
                                      EnableColumnVirtualization="True"
                                      VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                      SelectionChanged="DuplicatesGrid_SelectionChanged"
                                      PreviewMouseRightButtonDown="DuplicatesGrid_PreviewMouseRightButtonDown">
                                <DataGrid.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.ContainerStyle>
                                            <Style TargetType="{x:Type GroupItem}">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type GroupItem}">
                                                            <Expander IsExpanded="True" Margin="0,1,0,0">
                                                                <Expander.Header>
                                                                    <Border Background="{DynamicResource GroupRowBackground}" Padding="8,6">
                                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" TextTrimming="CharacterEllipsis" />
                                                                    </Border>
                                                                </Expander.Header>
                                                                <ItemsPresenter />
                                                            </Expander>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </GroupStyle.ContainerStyle>
                                    </GroupStyle>
                                </DataGrid.GroupStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="2*" />
                                    <DataGridTextColumn Header="Location" Binding="{Binding PathText}" Width="3*" />
                                    <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="95" />
                                    <DataGridTextColumn Header="Copies" Binding="{Binding CopyCountText}" Width="75" />
                                    <DataGridTextColumn Header="Wasted" Binding="{Binding WastedText}" Width="100" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

                    <Border Grid.Column="2" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="AI Advice" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" />
                                <TextBlock x:Name="DuplicateAdviceModelTextBlock" DockPanel.Dock="Right" Foreground="{DynamicResource MutedText}" TextTrimming="CharacterEllipsis" MaxWidth="170" />
                            </DockPanel>
                            <TextBlock x:Name="DuplicateAdviceSelectionTextBlock" Grid.Row="1" Text="Select a duplicate set" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <DockPanel Grid.Row="2" Margin="0,0,0,10">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button x:Name="AnalyzeDuplicateButton" Style="{StaticResource PrimaryButton}" Content="Analyze" Click="AnalyzeDuplicateButton_Click" IsEnabled="False" />
                                    <Button x:Name="CancelDuplicateAdviceButton" Style="{StaticResource ToolbarButton}" Content="Cancel" Click="CancelFoundryButton_Click" IsEnabled="False" />
                                </StackPanel>
                                <TextBlock x:Name="DuplicateAdviceStatusTextBlock" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <TextBlock x:Name="DuplicateAdviceSummaryTextBlock" Grid.Row="3" Foreground="{DynamicResource PrimaryText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <ListBox x:Name="DuplicateAdviceListBox" Grid.Row="4" BorderThickness="0" Background="Transparent" ScrollViewer.CanContentScroll="True">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="2,8">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding ActionText}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,0,8,3" />
                                                <TextBlock Grid.Column="1" Text="{Binding ConfidenceText}" Foreground="{DynamicResource MutedText}" HorizontalAlignment="Right" />
                                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Path}" Foreground="{DynamicResource PrimaryText}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,3" />
                                                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Reason}" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" FontSize="12" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="DuplicateAdviceSafetyTextBlock" Grid.Row="5" Text="AI advice is non-destructive. Verify file contents before deleting anything." Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" FontSize="11" Margin="0,10,0,0" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Settings">
                <Grid Margin="0,10,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,14">
                                    <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" />
                                    <TextBlock x:Name="SettingsStatusTextBlock" DockPanel.Dock="Right" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center" />
                                </DockPanel>

                                <TextBlock Text="Logging" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,10" />
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="260" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Log level" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center" />
                                    <ComboBox x:Name="LogLevelComboBox" Grid.Column="1" />
                                </Grid>

                                <StackPanel Margin="0,0,0,10">
                                    <CheckBox x:Name="LogEachSdkFileCheckBox" Content="Log every SDK file result" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,8" />
                                    <CheckBox x:Name="LogToDebugOutputCheckBox" Content="Write logs to debug output" Foreground="{DynamicResource PrimaryText}" />
                                </StackPanel>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Retained log files" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center" />
                                    <TextBox x:Name="RetainedLogFilesTextBox" Grid.Column="1" />
                                </Grid>

                                <Separator Background="{DynamicResource BorderColor}" Margin="0,2,0,14" />
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="Foundry Local" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" />
                                    <TextBlock x:Name="FoundryStatusTextBlock" DockPanel.Dock="Right" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="520" />
                                </DockPanel>
                                <CheckBox x:Name="FoundryEnabledCheckBox" Content="Enable local AI advice" Foreground="{DynamicResource PrimaryText}" Checked="FoundrySetting_Changed" Unchecked="FoundrySetting_Changed" Margin="0,0,0,10" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Model" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center" />
                                    <ComboBox x:Name="FoundryModelComboBox" Grid.Column="1" MinWidth="300" SelectionChanged="FoundryModelComboBox_SelectionChanged" />
                                    <Button x:Name="RefreshFoundryModelsButton" Grid.Column="2" Style="{StaticResource ToolbarButton}" Content="Refresh" Click="RefreshFoundryModelsButton_Click" />
                                    <Button x:Name="PrepareFoundryModelButton" Grid.Column="3" Style="{StaticResource ToolbarButton}" Content="Prepare" Click="PrepareFoundryModelButton_Click" />
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Inference timeout (seconds)" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center" />
                                    <TextBox x:Name="FoundryTimeoutTextBox" Grid.Column="1" />
                                    <TextBlock x:Name="FoundryProbeStatusTextBlock" Grid.Column="2" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button x:Name="RunFoundryProbeButton" Style="{StaticResource PrimaryButton}" Content="Run Model Probe" Click="RunFoundryProbeButton_Click" />
                                    <Button x:Name="CancelFoundryButton" Style="{StaticResource ToolbarButton}" Content="Cancel" Click="CancelFoundryButton_Click" IsEnabled="False" />
                                </StackPanel>
                                <ProgressBar x:Name="FoundryProgressBar" Height="4" Minimum="0" Maximum="100" Visibility="Collapsed" Margin="0,0,0,12" />

                                <Separator Background="{DynamicResource BorderColor}" Margin="0,2,0,14" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Button x:Name="SaveSettingsButton" Style="{StaticResource PrimaryButton}" Content="Save" Click="SaveSettingsButton_Click" />
                                    <Button x:Name="ResetSettingsButton" Style="{StaticResource ToolbarButton}" Content="Reset" Click="ResetSettingsButton_Click" />
                                    <Button x:Name="OpenLogFolderButton" Style="{StaticResource ToolbarButton}" Content="Open Logs" Click="OpenLogFolderButton_Click" />
                                    <Button x:Name="OpenSettingsFileButton" Style="{StaticResource ToolbarButton}" Content="Open Settings" Click="OpenSettingsFileButton_Click" />
                                </StackPanel>

                                <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Settings file" Foreground="{DynamicResource MutedText}" VerticalAlignment="Top" Margin="0,0,12,8" />
                                <TextBlock x:Name="SettingsFilePathTextBlock" Grid.Column="1" Foreground="{DynamicResource PrimaryText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <TextBlock Grid.Row="1" Text="Log folder" Foreground="{DynamicResource MutedText}" VerticalAlignment="Top" Margin="0,0,12,8" />
                                <TextBlock x:Name="LogDirectoryPathTextBlock" Grid.Row="1" Grid.Column="1" Foreground="{DynamicResource PrimaryText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <TextBlock Grid.Row="2" Text="Current log" Foreground="{DynamicResource MutedText}" VerticalAlignment="Top" Margin="0,0,12,0" />
                                <TextBlock x:Name="CurrentLogFilePathTextBlock" Grid.Row="2" Grid.Column="1" Foreground="{DynamicResource PrimaryText}" TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="16,9">
            <DockPanel>
                <TextBlock x:Name="DriveSummaryTextBlock" Foreground="{DynamicResource MutedText}" />
                <TextBlock DockPanel.Dock="Right" Text="Powered by voidtools Everything SDK" Foreground="{DynamicResource MutedText}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
