<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EverythingDiskUsage.FoundryWorker</RootNamespace>
    <AssemblyName>EverythingDiskUsage.FoundryWorker</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>false</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AI.Foundry.Local.WinML" Version="1.2.4" />
    <PackageReference Include="Microsoft.WindowsAppSDK.ML" Version="2.1.74" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Services\Foundry\FoundryWorkerProtocol.cs" Link="Shared\FoundryWorkerProtocol.cs" />
  </ItemGroup>

</Project>
