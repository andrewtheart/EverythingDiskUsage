<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Everything64.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Compile Remove="EverythingDiskUsage.FoundryWorker\**\*.cs" />
    <Content Remove="EverythingDiskUsage.FoundryWorker\**\*" />
    <EmbeddedResource Remove="EverythingDiskUsage.FoundryWorker\**\*" />
    <None Remove="EverythingDiskUsage.FoundryWorker\**\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0-preview.6.26359.118" />
  </ItemGroup>

  <PropertyGroup>
    <BuildFoundryWorker Condition="'$(BuildFoundryWorker)' == ''">true</BuildFoundryWorker>
    <FoundryWorkerProject>$(MSBuildThisFileDirectory)EverythingDiskUsage.FoundryWorker\EverythingDiskUsage.FoundryWorker.csproj</FoundryWorkerProject>
    <FoundryWorkerOutput>$(MSBuildThisFileDirectory)EverythingDiskUsage.FoundryWorker\bin\$(Configuration)\net11.0-windows10.0.19041.0\win-x64\publish\</FoundryWorkerOutput>
  </PropertyGroup>

  <Target Name="BuildFoundryWorker"
          BeforeTargets="BeforeBuild"
          Condition="'$(BuildFoundryWorker)' == 'true' And '$(DesignTimeBuild)' != 'true' And Exists('$(FoundryWorkerProject)')">
    <Exec Command="dotnet publish &quot;$(FoundryWorkerProject)&quot; -c $(Configuration) -r win-x64 --self-contained true --nologo -v quiet" />
  </Target>

  <Target Name="CopyFoundryWorkerToOutput"
          AfterTargets="Build"
          Condition="'$(BuildFoundryWorker)' == 'true' And '$(DesignTimeBuild)' != 'true' And Exists('$(FoundryWorkerOutput)EverythingDiskUsage.FoundryWorker.exe')">
    <ItemGroup>
      <_FoundryWorkerFiles Include="$(FoundryWorkerOutput)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_FoundryWorkerFiles)"
          DestinationFiles="@(_FoundryWorkerFiles->'$(OutDir)foundry-worker\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyFoundryWorkerToPublish"
          AfterTargets="Publish"
          Condition="'$(BuildFoundryWorker)' == 'true' And '$(DesignTimeBuild)' != 'true' And Exists('$(FoundryWorkerOutput)EverythingDiskUsage.FoundryWorker.exe')">
    <ItemGroup>
      <_FoundryWorkerPublishFiles Include="$(FoundryWorkerOutput)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_FoundryWorkerPublishFiles)"
          DestinationFiles="@(_FoundryWorkerPublishFiles->'$(PublishDir)foundry-worker\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!--
    BuildInstaller — runs automatically after every `dotnet publish`.
    Requires Inno Setup 6 (https://jrsoftware.org/isdl.php).
    Assumes Inno Setup was installed machine-wide.
    Override the compiler path via: dotnet publish /p:IsccPath="C:\...\ISCC.exe"
  -->
    <Target Name="BuildInstaller"
      AfterTargets="Publish"
      DependsOnTargets="CopyFoundryWorkerToPublish">
    <PropertyGroup>
      <!-- Locate ISCC.exe in the standard machine-wide install paths, then allow a custom override. -->
      <_IsccPath Condition="'$(_IsccPath)' == '' And Exists('C:\Program Files (x86)\Inno Setup 6\ISCC.exe')">C:\Program Files (x86)\Inno Setup 6\ISCC.exe</_IsccPath>
      <_IsccPath Condition="'$(_IsccPath)' == '' And Exists('C:\Program Files\Inno Setup 6\ISCC.exe')">C:\Program Files\Inno Setup 6\ISCC.exe</_IsccPath>
      <!-- Allow the caller to supply a custom path: /p:IsccPath="..." -->
      <_IsccPath Condition="'$(IsccPath)' != ''">$(IsccPath)</_IsccPath>
      <_RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..'))</_RepoRoot>
      <!-- Output folder lives in the repo root, not in the temp publish dir. -->
      <_InstallerOutputDir>$(_RepoRoot)\installer-output</_InstallerOutputDir>
      <_InstallerIss>$(_RepoRoot)\installer\installer.iss</_InstallerIss>
      <!-- Resolve PublishDir to an absolute path, then strip any trailing slash so Inno Setup Source globs resolve correctly. -->
      <_PublishDirFull Condition="$([System.IO.Path]::IsPathRooted('$(PublishDir)'))">$(PublishDir)</_PublishDirFull>
      <_PublishDirFull Condition="'$(_PublishDirFull)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\$(PublishDir)'))</_PublishDirFull>
      <_PublishDirTrimmed>$(_PublishDirFull.TrimEnd('\').TrimEnd('/'))</_PublishDirTrimmed>
      <_InstallerVersion>$(Version)</_InstallerVersion>
      <_InstallerVersion Condition="'$(_InstallerVersion)' == ''">1.0.0</_InstallerVersion>
    </PropertyGroup>

    <Warning Text="Inno Setup compiler not found in the standard machine-wide install path; skipping installer build. Install with: winget install JRSoftware.InnoSetup --scope machine"
             Condition="'$(_IsccPath)' == ''" />

    <MakeDir Directories="$(_InstallerOutputDir)" Condition="'$(_IsccPath)' != ''" />

        <Exec Command="&quot;$(_IsccPath)&quot; &quot;/DPublishDir=$(_PublishDirTrimmed)&quot; &quot;/DAppVersion=$(_InstallerVersion)&quot; &quot;/DOutputDir=$(_InstallerOutputDir)&quot; &quot;$(_InstallerIss)&quot;"
          WorkingDirectory="$(_RepoRoot)\installer"
          Condition="'$(_IsccPath)' != ''" />
  </Target>

</Project>
